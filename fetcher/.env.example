# ── NBA Konfiguráció ──────────────────────────────────────────────────────────
# Aktuális NBA szezon (formátum: ÉÉÉÉ-ÉÉ, pl. 2025-26)
NBA_SEASON=2025-26

# API hívások közti késleltetés másodpercben (ajánlott: legalább 1.0)
REQUEST_DELAY=1.5

# Minimális meccsszám a megjelenítéshez
MIN_GAMES=10

# ── Firebase Konfiguráció ─────────────────────────────────────────────────────
# Service account JSON fájl elérési útja (töltsd le a Firebase Console-ból)
FIREBASE_SERVICE_ACCOUNT=serviceAccount.json
